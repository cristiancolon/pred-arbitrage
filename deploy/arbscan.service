# systemd *user* unit template: deploy/install.sh fills in @REPO_DIR@ with the
# repo's actual location and installs it (see README).
# Runs the scanner, the scheduled catalog/match refresh, and the dashboard.
[Unit]
Description=arbscan: Kalshi / Polymarket US arbitrage scanner + dashboard (read-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO_DIR@
ExecStart=@REPO_DIR@/.venv/bin/arbscan serve
Restart=always
RestartSec=15
# Normal CPU priority so the price feeds are handled promptly; the hourly refresh
# (catalog, match, Jev review) runs as a separate niced subprocess instead. Steady
# state is ~100-200 MB with a few thousand streamed books; a refresh adds ~200 MB.
MemoryHigh=2G
MemoryMax=3G
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
